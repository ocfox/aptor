{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1",
        "detour": "Proxy"
      },
      {
        "type": "https",
        "tag": "domestic",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "steamcontent.com",
          "steamserver.net"
        ],
        "action": "route",
        "server": "domestic"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-private",
          "geosite-category-games-cn",
          "geosite-category-game-platforms-download"
        ],
        "action": "route",
        "server": "domestic"
      },
      {
        "query_type": [
          "HTTPS"
        ],
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "remote",
    "strategy": "prefer_ipv6"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "Proxy"
    }
  ],
  "route": {
    "default_domain_resolver": "domestic",
    "default_http_client": "proxy-client",
    "rule_set": [
      {
        "type": "remote",
        "format": "binary",
        "tag": [
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini",
          "geosite-perplexity",
          "geosite-deepseek",
          "geosite-xai",
          "geosite-category-ai-!cn"
        ],
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "type": "remote",
        "format": "binary",
        "tag": [
          "geosite-cn",
          "geosite-private",
          "geosite-category-games-cn",
          "geosite-category-game-platforms-download",
          "geosite-geolocation-!cn",
          "geosite-spotify"
        ],
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "type": "remote",
        "format": "binary",
        "tag": "geoip-cn",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "port": 443,
        "network": "udp",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-spotify"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "port": 22,
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini",
          "geosite-perplexity",
          "geosite-deepseek",
          "geosite-xai",
          "geosite-category-ai-!cn"
        ],
        "action": "route",
        "outbound": "AI"
      },
      {
        "ip_cidr": [
          "2401:b60:e0fd::/48"
        ],
        "action": "route",
        "outbound": "Others"
      },
      {
        "domain_suffix": [
          "steamcontent.com",
          "steamserver.net"
        ],
        "action": "route",
        "outbound": "CN"
      },
      {
        "rule_set": [
          "geosite-category-game-platforms-download",
          "geosite-category-games-cn"
        ],
        "action": "route",
        "outbound": "CN"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "action": "route",
        "outbound": "CN"
      },
      {
        "domain_suffix": [
          "push.apple.com"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
            "geosite-geolocation-!cn"
        ],
        "action": "route",
        "outbound": "Others"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "CN"
      }
    ],
    "final": "Proxy",
    "auto_detect_interface": true,
    "find_process": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "Proxy"
    }
  }
}
